* text=auto

# Source files use stable line endings across Windows and WSL.
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets must never be rewritten by Git.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
*.onnx binary
